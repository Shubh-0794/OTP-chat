# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (configure in Vercel / Netlify dashboard under Environment Variables)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
SUPABASE_SECRET_KEY="sb_secret_placeholder"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_placeholder"

# WhatsApp Gateway Service URL (running on local machine, VPS, Railway or Render)
OPEN_WA_SERVER_URL="https://your-wa-gateway.onrender.com"
